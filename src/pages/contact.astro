---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact">
  <section class="py-20 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-4xl sm:text-5xl font-bold text-slate-900 dark:text-slate-100 mb-8 animate-fade-in-up">
        Get In Touch
      </h1>

      <div class="prose prose-lg prose-slate dark:prose-invert max-w-none">
        <p class="text-xl text-slate-600 dark:text-slate-400 mb-12">
          I'm always interested in discussing AI, data engineering, and new opportunities. Feel free to reach out!
        </p>

        <div class="grid md:grid-cols-2 gap-8 mb-12">
          <div class="bg-slate-50 dark:bg-slate-800 rounded-lg p-6 border border-slate-200 dark:border-slate-700">
            <h2 class="text-xl font-semibold text-slate-900 dark:text-slate-100 mb-4">Email</h2>
            <a href="mailto:yassinay25@gmail.com" class="text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 font-semibold text-lg" target="_blank" rel="noopener noreferrer">
              yassinay25@gmail.com
            </a>
          </div>

          <div class="bg-slate-50 dark:bg-slate-800 rounded-lg p-6 border border-slate-200 dark:border-slate-700">
            <h2 class="text-xl font-semibold text-slate-900 dark:text-slate-100 mb-4">Location</h2>
            <p class="text-slate-600 dark:text-slate-400 text-lg">
              Available for remote opportunities worldwide
            </p>
          </div>
        </div>

        <div class="grid md:grid-cols-2 gap-8 mb-12">
          <div class="bg-slate-50 dark:bg-slate-800 rounded-lg p-6 border border-slate-200 dark:border-slate-700">
            <h2 class="text-xl font-semibold text-slate-900 dark:text-slate-100 mb-4">GitHub</h2>
            <a href="https://github.com/NAITIDER" target="_blank" rel="noopener noreferrer" class="text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 font-semibold text-lg">
              github.com/NAITIDER
            </a>
          </div>

          <div class="bg-slate-50 dark:bg-slate-800 rounded-lg p-6 border border-slate-200 dark:border-slate-700">
            <h2 class="text-xl font-semibold text-slate-900 dark:text-slate-100 mb-4">LinkedIn</h2>
            <a href="https://www.linkedin.com/in/yassine-nait-ider-646912294/" target="_blank" rel="noopener noreferrer" class="text-blue-600 dark:text-blue-400 hover:text-blue-700 dark:hover:text-blue-300 font-semibold text-lg">
              linkedin.com/in/yassine-nait-ider-646912294/
            </a>
          </div>
        </div>

        <div class="bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-lg p-8">
          <h2 class="text-2xl font-bold text-slate-900 dark:text-slate-100 mb-4">
            Let's Connect
          </h2>
          <p class="text-slate-700 dark:text-slate-300 mb-6">
            Whether you have a question, want to discuss a project, or are interested in collaboration, I'd love to hear from you. I typically respond within 24-48 hours.
          </p>
          <a href="mailto:yassinay25@gmail.com" class="px-8 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg transition-colors inline-block" target="_blank" rel="noopener noreferrer">
            Send Me an Email
          </a>
        </div>


      </div>
    </div>
  </section>
</BaseLayout>
